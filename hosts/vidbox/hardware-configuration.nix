{ config, lib, modulesPath, ... }:
# Hardware for `vidbox`: a physical i7-8700 (UEFI, one SATA disk) that replaced
# the Hyper-V guest of the same name. Generated by nixos-generate-config on the
# box's initial install; the partitions were made by the NixOS installer, not
# disko, so filesystems are referenced by UUID.
{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "ahci" "sd_mod" "sr_mod" ];
  boot.kernelModules = [ "kvm-intel" ];

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/af4149fd-4b3a-4f85-80bb-d143441b3db2";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/5FDC-5F98";
    fsType = "vfat";
    options = [ "fmask=0077" "dmask=0077" ];
  };

  swapDevices = [{ device = "/swapfile"; size = 8192; }];

  networking = {
    hostName = "vidbox";
    useDHCP = lib.mkDefault true;
    enableIPv6 = false;
  };

  nixpkgs.hostPlatform = "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
