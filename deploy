#!/bin/sh
set -eu

command -v nix >/dev/null 2>&1 || {
  printf '%s\n' 'ERROR: Nix is required; install Nix before running deploy.' >&2
  exit 1
}
launcher=$0
case "$launcher" in
  */*) ;;
  *) launcher=$(command -v "$launcher") ;;
esac
case "$launcher" in
  /*) ;;
  *) launcher=./$launcher ;;
esac
launcher_dir=$(CDPATH= cd -P "${launcher%/*}" && pwd -P)

exec nix --extra-experimental-features 'nix-command flakes' \
  run --no-update-lock-file --no-write-lock-file --no-use-registries \
  --accept-flake-config "$launcher_dir#deploy" -- "$@"
